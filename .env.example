# ===== LLM 配置（DeepSeek，Anthropic 兼容接口）=====
# 主模型（也可在 config.yaml 的 llm.model 中配置）
LLM_MODEL_NAME=deepseek-v4-flash
# TOOL_LLM_MODEL_NAME=deepseek-v4-flash
# API Key（必填，替换为你自己的 key）
LLM_API_KEY=sk-your-api-key-here
# Anthropic 兼容端点
LLM_URL=https://api.deepseek.com/anthropic


# S2_API_KEY=
# OPENALEX_MAILTO=