# ===== LLM 配置（DeepSeek，Anthropic 兼容接口）=====
# 主模型（也可在 config.yaml 的 llm.model 中配置）
LLM_MODEL_NAME=deepseek-v4-flash
# API Key（必填，替换为你自己的 key）
LLM_API_KEY=sk-your-api-key-here
# Anthropic 兼容端点
LLM_URL=https://api.deepseek.com/anthropic
# 工具内部调用使用的快速模型（PDF 提取、引用比对等；不填默认 deepseek-v4-flash）
# TOOL_LLM_MODEL_NAME=deepseek-v4-flash

# ===== Semantic Scholar（可选）=====
# 配置后文献检索限流从 1 req/s 提升到约 100 req/s
# S2_API_KEY=

# ===== OpenAlex（可选）=====
# 填写邮箱可进入 polite pool，获得更稳定的请求配额
# OPENALEX_MAILTO=
